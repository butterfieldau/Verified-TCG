{
  "expo": {
    "name": "Verified TCG",
    "slug": "verified-tcg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "verified-tcg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#100E0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.verifiedtcg.app",
      "buildNumber": "8"
    },
    "android": {
      "backgroundColor": "#100E0F"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "themeColor": "#100E0F",
      "backgroundColor": "#100E0F"
    },
    "extra": {
      "apiBaseUrl": "https://app.verifiedtcg.co",
      "eas": {
        "projectId": "fde9dffb-2952-4ee6-825a-daff5adb8a92"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://verifiedtcg.co"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Verified TCG uses your camera to scan and identify trading cards. Photos are only used for card recognition and are never stored.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C89B3C",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
