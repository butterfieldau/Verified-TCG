# Public HTTPS origin used by native TestFlight builds for every API request.
# This must be a published, internet-reachable API deployment. Do not use a
# Replit editor/preview URL, localhost, a private deployment, or a URL ending
# in /api. Replit Shield/access control must be disabled for this API origin so
# the app's own authentication routes receive the request.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
