# ─────────────────────────────────────────────────────────────────
# Verified TCG — API Server environment variables
# Copy this file to .env and fill in real values before running.
# Never commit .env with real secrets to source control.
# ─────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────

# Secret used to sign and verify JWTs.
# Must be at least 32 characters long.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# PostgreSQL connection string for the primary database.
DATABASE_URL=

# ── AI / Vision API (card scanner) ───────────────────────────────

# OpenAI API key used by the card-recognition endpoint.
# Provided automatically by the Replit AI Integrations proxy.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── JustTCG catalog API ───────────────────────────────────────────

# API key for the JustTCG card catalog service.
JUSTTCG_API_KEY=

# ── eBay (graded price lookups) ──────────────────────────────────

# eBay AppID / ClientID for Finding API calls.
EBAY_APP_ID=

# ── PSA Grading ───────────────────────────────────────────────────

# PSA API token for graded-card certification lookups.
PSA_API_TOKEN=

# ── Transactional email (password reset / support) ───────────────

# Resend API key for sending emails.
RESEND_API_KEY=

# From-address for password reset emails (must be a verified sender domain in Resend).
# Defaults to "noreply@verifiedtcg.com" if not set.
RESET_FROM_EMAIL=noreply@verifiedtcg.com

# ── CORS (production only) ────────────────────────────────────────

# Comma-separated list of allowed origins for CORS in production.
# Defaults to https://verifiedtcg.com,https://www.verifiedtcg.com if not set.
# Not used in development (all origins are allowed).
ALLOWED_ORIGINS=https://verifiedtcg.com,https://www.verifiedtcg.com

# ── Runtime ───────────────────────────────────────────────────────

# Set to "production" in deployed environments.
# Controls CORS policy and log formatting.
NODE_ENV=development

# ── Development-only features ────────────────────────────────────

# Set to "true" ONLY in local development to enable the /api/subscription/upgrade
# endpoint that skips payment processing and directly grants Pro access.
# The endpoint is also rejected in production regardless of this value.
# Leave blank (or false) for all staging and production deployments.
# Default: blank (endpoint is disabled in all environments).
ENABLE_DEV_UPGRADE=

# Port the server listens on.  Defaults to 3000 if not set.
PORT=3000
