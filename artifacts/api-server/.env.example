# Server-only provider credentials. Never expose these as EXPO_PUBLIC_* variables.
JUSTTCG_API_KEY=
PSA_API_TOKEN=
# eBay Developer App ID (free — register at developer.ebay.com)
# Used by the Finding API to fetch real graded card sold prices.
EBAY_APP_ID=

# eBay Marketplace Account Deletion notification endpoint configuration.
# EBAY_VERIFICATION_TOKEN: a secret string (32–80 chars) that YOU create and
#   paste into the eBay developer console when registering the endpoint.
#   eBay uses it to sign outgoing notifications and to verify the challenge.
# EBAY_ENDPOINT_URL: the full public HTTPS URL of the deletion endpoint,
#   e.g. https://api.verifiedtcg.co/api/ebay/account-deletion
#   Must match exactly what is registered in the eBay developer console.
EBAY_VERIFICATION_TOKEN=
EBAY_ENDPOINT_URL=
