# Server
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/verified_tcg
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-publishable-or-anon-key
API_ALLOWED_ORIGINS=https://verifiedtcg.co,https://www.verifiedtcg.co

# Mobile app public configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Replit Preview/Production should provide the same values through Secrets.
# The mobile app's API URL must be the public Replit API origin when testing
# from a phone, for example https://your-app.replit.app.
